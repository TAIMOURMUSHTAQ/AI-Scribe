# ---- AI engine -------------------------------------------------------------
# openai = real AI (needs OPENAI_API_KEY). mock = demo mode: no key, no data leaves the machine.
AI_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_openai_api_key

# Clinical analysis + SOAP model. gpt-5.4-mini with low reasoning gives better gaps and plan proposals.
# gpt-4.1-mini is faster to first words but weaker at clinical reasoning (leave OPENAI_REASONING_EFFORT empty for it).
OPENAI_CLINICAL_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# ---- Time limits (seconds): a stuck call fails with a clear message instead of loading forever
AI_CONNECT_TIMEOUT=10
AI_STREAM_IDLE_TIMEOUT=90
AI_PIPELINE_TIMEOUT=180
AI_TRANSCRIBE_TIMEOUT=60
AI_MAX_RETRIES=1
AI_MAX_CONCURRENT=8

# ---- Limits -----------------------------------------------------------------
MAX_AUDIO_SIZE_MB=25
MAX_INPUT_CHARS=30000

# ---- Laravel integration (leave empty for the standalone demo UI) -------------
# When set, every /api/scribe/* call must send header X-Service-Token: <value>
SERVICE_TOKEN=

LOG_LEVEL=INFO
